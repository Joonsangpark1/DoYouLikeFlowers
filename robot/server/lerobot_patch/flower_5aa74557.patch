--- a/src/lerobot/scripts/lerobot_train.py
+++ b/src/lerobot/scripts/lerobot_train.py
@@ -30,6 +30,7 @@ torchrun --nproc-per-node=8 $(which lerobot-train) \
 
 import dataclasses
 import logging
+import os
 import sys
 import time
 from collections.abc import Iterator
@@ -735,6 +736,11 @@ def train(cfg: TrainPipelineConfig):
     for _ in range(step, cfg.steps):
         step_start = time.perf_counter()
         batch = next(dl_iter)
+        # (11-22 flower 패치) 관절 상태에 가우시안 노이즈 (단위 = 원래 상태 단위, 도). 배치마다 1도 미만 다른 시작 자세로
+        # 배치를 외우는 지름길을 끊어서 사진을 보게 함. FLOWER_STATE_NOISE_STD 없거나 0이면 원래 동작
+        _sn = float(os.environ.get("FLOWER_STATE_NOISE_STD", "0") or 0)
