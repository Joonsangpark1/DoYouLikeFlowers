{
  "env": {
    "name": "real_robot",
    "fps": 10,
    "robot": {
      "type": "so101_follower",
      "port": "/dev/ttyACM0",
      "id": "my_follower_arm",
      "disable_torque_on_disconnect": false,
      "max_relative_target": 10.0,
      "cameras": {
        "front": {
          "type": "usbip_camera",
          "index_or_path": "/dev/video0",
          "fourcc": "MJPG",
          "width": 640,
          "height": 480,
          "fps": 30,
          "preview_port": 8080
        }
      }
    },
    "teleop": {
      "type": "remote_gamepad",
      "port": 5557,
      "use_gripper": true,
      "deadzone": 0.15,
      "x_sign": 1.0,
      "y_sign": 1.0,
      "z_sign": 1.0,
      "swap_gripper": false
    },
    "processor": {
      "control_mode": "gamepad",
      "observation": {
        "display_cameras": false
      },
      "image_preprocessing": null,
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": 0.0
      },
      "reset": {
        "fixed_reset_joint_positions": null,
        "reset_time_s": 0.0,
        "control_time_s": 20.0,
        "terminate_on_success": true
      },
      "inverse_kinematics": {
        "urdf_path": "urdf/so101_new_calib.urdf",
        "target_frame_name": "gripper_frame_link",
        "end_effector_bounds": {
          "min": [
            0.075,
            -0.278,
            -0.001
          ],
          "max": [
            0.398,
            0.15,
            0.3
          ]
        },
        "end_effector_step_sizes": {
          "x": 0.01,
          "y": 0.01,
          "z": 0.01
        }
      },
      "max_gripper_pos": 100.0
    }
  },
  "dataset": {
    "repo_id": "parkjoonsang/flower_hil_demo",
    "root": null,
    "task": "Grasp the flower stem.",
    "num_episodes_to_record": 20,
    "push_to_hub": false
  },
  "mode": "record",
  "device": "cpu"
}
